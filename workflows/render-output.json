        "jsCode": "const raw=$json.body ?? $json; const result=raw.result || raw; const format=String(raw.output_format || result.output_format || 'json').toLowerCase(); if(!['json','text','xlsx','rtf','html','chart','pdf'].includes(format)) throw new Error('unsupported output_format'); return [{json:{...result,test_mode:raw.test_mode===true || result.test_mode===true,output_format:format}}];"
      },
